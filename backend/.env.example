# Bu dosyayı .env olarak kopyalayıp değerleri kendinize göre değiştirin.
# .env git'e gönderilmez (.gitignore'da).

# Yönetici panelindeki PIN. ZORUNLU — tanımlı değilse sunucu açılmaz
# (kodun içinde bilerek hiçbir yedek/varsayılan değer yok). Ne kadar
# uzun ve rastgele olursa kaba kuvvet denemelerine o kadar dayanıklı olur.
ADMIN_PIN=1234A

# Frontend'in çalıştığı adresler (virgülle ayrılmış). Vercel adresinizi değiştirirseniz güncelleyin.
CORS_ORIGINS=http://localhost:5173,https://qr-kodlu-menu-beta.vercel.app

# Veritabanı dosyası (varsayılan yeterli, değiştirmenize gerek yok)
DATABASE_URL=sqlite:///./menu.db
